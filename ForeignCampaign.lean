def chosen : QueueSchedule := [[3],[2,1,0]]
def baseline : QueueSchedule := [[0,1,2,3],[]]
def dominates := FiniteFrontier.strictPareto [0,1] cost

theorem candidate_count : candidates.length = 120 := by decide
theorem no_duplicate_candidates : candidates.eraseDups.length = 120 := by decide
theorem all_candidates_feasible : candidates.all (queueFeasible 4 2) = true := by decide
-- Recompute every supplied model metric from the duration observations.
theorem receipt_metrics_match : receiptRows.all (fun r =>
    [cost r.1 0, cost r.1 1] == r.2) = true := by decide

theorem chosen_accepted :
    nondominatedInSuppliedFiniteList candidates dominates chosen = true := by decide

theorem chosen_nondominated : chosen ∈ candidates ∧
    ∀ q, q ∈ candidates → dominates q chosen = false :=
  (nondominatedInSuppliedFiniteList_exact candidates dominates chosen).mp chosen_accepted

theorem modeled_improvement : dominates chosen baseline = true := by decide

theorem modeled_improvement_exact :
    (∀ i, i ∈ [0,1] → cost chosen i ≤ cost baseline i) ∧
    (∃ i, i ∈ [0,1] ∧ cost chosen i < cost baseline i) :=
  (FiniteFrontier.pareto_exact [0,1] cost chosen baseline).mp modeled_improvement

theorem chosen_cost : [cost chosen 0, cost chosen 1] = [6991879848,10280231762] := by decide
theorem baseline_cost : [cost baseline 0, cost baseline 1] = [9006285993,13775558659] := by decide

def expectedFrontier : List QueueSchedule := [[[1, 0], [2, 3]], [[2, 1, 0], [3]], [[2, 3], [1, 0]], [[3], [2, 1, 0]]]
theorem complete_list_frontier : FiniteFrontier.frontier candidates dominates = expectedFrontier := by decide

