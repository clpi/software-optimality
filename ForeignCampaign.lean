-- Durations are input observations, not facts proved by Lean.
def duration : Nat → Nat
  | 0 => 1033599117
  | 1 => 687668287
  | 2 => 293138741
  | 3 => 6991879848
  | _ => 0

def queueTime (q : List Nat) := (q.map duration).sum

def completionSum : Nat → List Nat → Nat
  | _, [] => 0
  | elapsed, j :: js =>
    let finish := elapsed + duration j
    finish + completionSum finish js

def cost (qs : QueueSchedule) (axis : Nat) : Int :=
  if axis = 0 then Int.ofNat (qs.foldl (fun m q => max m (queueTime q)) 0)
  else Int.ofNat ((qs.map (completionSum 0)).sum)

